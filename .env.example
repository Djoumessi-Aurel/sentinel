# Copier en .env et adapter. Le .env n'est jamais commité (docs/SECURITY.md A02).

# --- Base de données MySQL 8 -------------------------------------------------
# En développement local, l'instance standalone démarrée par `npm run dev:mysql`
# écoute sur le port 3307 pour ne pas entrer en conflit avec un MySQL déjà
# présent sur le poste.
DATABASE_URL="mysql://sentinel:sentinel@127.0.0.1:3307/sentinel"

# --- Stockage des logs -------------------------------------------------------
# `mysql`      : adaptateur de développement, aucune infrastructure à installer.
# `opensearch` : cible de production (docs/DECISIONS.md D002).
LOG_STORE=mysql
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=sentinel-logs
# Laisser vide si la sécurité OpenSearch est désactivée (jamais en production).
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# --- Backend -----------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Origines autorisées pour le CORS et le WebSocket, séparées par des virgules.
# Jamais `*` (docs/SECURITY.md A05).
CORS_ORIGINS=http://localhost:3000

# Adresses des reverse proxies autorisés à renseigner X-Forwarded-For.
# Vide = aucun proxy, l'en-tête est ignoré (bon réglage en développement, et en
# production si le backend est joignable directement).
# Derrière nginx sur la même machine : TRUST_PROXY=loopback
# Derrière un proxy distant : TRUST_PROXY=10.12.0.4
TRUST_PROXY=

# Sel de hachage des tokens d'agent. À générer une fois par environnement :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN_SECRET=changez-moi-en-production

# Décalage, en minutes, du fuseau dans lequel les applications supervisées
# écrivent leurs horodatages de log. 60 pour les serveurs du GIE (UTC+1).
# Voir docs/DECISIONS.md D003.
LOG_SOURCE_UTC_OFFSET_MINUTES=60

# --- Authentification (docs/AUTH.md) -----------------------------------------
# `ldap` : l'Active Directory vérifie les mots de passe. Réglage de production.
# `dev`  : l'annuaire est remplacé par huit personnes fictives et le mot de passe
#          n'est PAS vérifié. Refusé si NODE_ENV=production.
AUTH_MODE=dev

# Clé de signature des cookies de session, 32 caractères minimum. À générer une
# fois par environnement :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET=changez-moi-32-caracteres-minimum-svp

# Clé de protection des secrets de double authentification, 32 octets minimum.
# Sa perte rend illisibles les secrets TOTP déjà appairés : les utilisateurs
# concernés devront réappairer leur application d'authentification.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=changez-moi-64-caracteres-hexadecimaux-svp-0000000000000000000000

# Durée de session d'une personne (heures) et du compte d'affichage (jours).
# L'écran de l'open space n'a personne pour s'y reconnecter.
AUTH_SESSION_HOURS=12
AUTH_VIEWER_SESSION_DAYS=30

# Empreintes scrypt des deux comptes techniques, générées par :
#   npm run auth:hash-password --workspace @sentinel/backend
# SENTINEL_ADMIN_PASSWORD_HASH est OBLIGATOIRE : sans lui, personne ne peut
# administrer l'application et le backend refuse de démarrer.
# Les apostrophes sont nécessaires, l'empreinte contient des caractères $.
SENTINEL_USER_PASSWORD_HASH=''
SENTINEL_ADMIN_PASSWORD_HASH=''

# Active Directory. Obligatoires dès que AUTH_MODE=ldap.
# Vérifier le réglage sans démarrer l'application :
#   npm run auth:test-ldap --workspace @sentinel/backend -- <fragment> --login <identifiant>
LDAP_URL=ldap://serveur-ad.gie.local:389
LDAP_DOMAIN=@gie.local
LDAP_BASE_DN=dc=gie,dc=local
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_TIMEOUT_MS=10000

# --- Canal email -------------------------------------------------------------
SMTP_HOST=smtp.gie.local
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinel@gie.local

# --- Canal SMS ---------------------------------------------------------------
SMS_GATEWAY_URL=http://smsalertgie.gie.local/send
SMS_GATEWAY_API_KEY=

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
