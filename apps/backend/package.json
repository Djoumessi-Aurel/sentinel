{
  "name": "@sentinel/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend NestJS de Sentinel : ingestion, parsing, alertes, temps réel",
  "scripts": {
    "build": "nest build",
    "dev": "node ../../scripts/with-env.mjs nest start --watch",
    "start": "node ../../scripts/with-env.mjs node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:migrate": "node ../../scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "node ../../scripts/with-env.mjs ts-node --transpile-only prisma/seed.ts",
    "db:push": "node ../../scripts/with-env.mjs prisma db push"
  },
  "prisma": {
    "seed": "node ../../scripts/with-env.mjs ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "@sentinel/log-parsers": "0.1.0",
    "@sentinel/shared-types": "0.1.0",
    "helmet": "^8.0.0",
    "nodemailer": "^9.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
