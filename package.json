{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de monitoring de logs et de statut des services du parc applicatif monétique",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @sentinel/backend",
    "dev:frontend": "npm run dev --workspace @sentinel/frontend",
    "db:generate": "npm run db:generate --workspace @sentinel/backend",
    "db:migrate": "npm run db:migrate --workspace @sentinel/backend",
    "db:seed": "npm run db:seed --workspace @sentinel/backend",
    "audit:security": "node scripts/audit-security.mjs",
    "audit:all": "npm audit",
    "dev:mysql": "node scripts/dev-mysql.mjs start",
    "dev:mysql:stop": "node scripts/dev-mysql.mjs stop",
    "dev:mysql:status": "node scripts/dev-mysql.mjs status",
    "simulate": "node scripts/simulate-agent.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
